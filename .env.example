# Smart Capture AI provider key (optional). The app auto-selects a provider:
# 1. If VITE_GROQ_API_KEY is set, it uses Groq (fast, free tier).
# 2. Else if VITE_GEMINI_API_KEY is set, it uses Google Gemini.
# 3. Else it falls back to fully local rule-based parsing (no network calls).
#
# Get a free Groq key: https://console.groq.com/keys  (starts with gsk_)
# Get a free Gemini key: https://aistudio.google.com/apikey  (starts with AIza)
#
# NOTE: VITE_-prefixed vars are exposed to the browser bundle (frontend-only app).
# Use a free-tier key. On Vercel, add these as Environment Variables.

VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
